# Copy to .env. Every variable below is validated at boot by the Joi schema in src/app.module.ts.
# Optional values may be left empty: an empty value is accepted, never a boot failure.
# Comments live on their own lines because inline comments are parsed differently by dotenv
# and by docker compose.

NODE_ENV=development
PORT=3000
# Comma-separated web origins. Empty means none (the mobile apps do not need CORS).
CORS_ORIGINS=
# api | worker | all. The API process and the worker process run the same image.
WORKER_ROLE=all
MONGODB_URI=mongodb://localhost:27017/reels?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# Used by docker-compose.yml only (the compose file builds MONGODB_URI from them).
MONGO_ROOT_USERNAME=reels
MONGO_ROOT_PASSWORD=change-me
MONGO_DB_NAME=reels
API_PORT=3010
API_BIND=127.0.0.1

# China Parts database: a read-only user with column-level grants only
# (specs/002-chinaparts-reels-service/contracts/chinaparts-read-model.md).
CHINAPARTS_MYSQL_HOST=localhost
CHINAPARTS_MYSQL_PORT=3306
CHINAPARTS_MYSQL_DATABASE=chinaparts_dev
CHINAPARTS_MYSQL_USER=reels_ro
CHINAPARTS_MYSQL_PASSWORD=reels_ro_local
CHINAPARTS_MYSQL_SSL=false

# Value mappings for China Parts data. Single-quoted so backslashes stay literal.
CHINAPARTS_CUSTOMER_TYPES='App\Models\Customer,customer'
CHINAPARTS_SELLER_TYPES='App\Models\Seller,seller'
CHINAPARTS_PRODUCT_TYPES='App\Models\Product,product'
CHINAPARTS_SHOP_TYPES='App\Models\Shop,shop'
CHINAPARTS_SELLER_APPROVED_VALUES=approved,1
# Mirrors sanctum.expiration. Empty means tokens do not expire.
CHINAPARTS_TOKEN_EXPIRATION_MINUTES=
CHINAPARTS_PRODUCT_IMAGE_COLLECTION=images
CHINAPARTS_SHOP_IMAGE_COLLECTION=logo
CHINAPARTS_SELLER_IMAGE_COLLECTION=avatar
CHINAPARTS_MEDIA_URL_TEMPLATE={diskUrl}/{id}/{file_name}
CHINAPARTS_DISK_URLS=public=http://localhost:8000/storage
CHINAPARTS_PUBLIC_STORAGE_URL=http://localhost:8000/storage
CHINAPARTS_BASE_CURRENCY=SAR
# Where China Parts keeps exchange rates. Letters, digits and underscore only.
CHINAPARTS_FX_TABLE=currencies
CHINAPARTS_FX_CODE_COLUMN=code
CHINAPARTS_FX_RATE_COLUMN=exchange_rate
# per_base: units of that currency per 1 base unit. to_base: the reverse.
CHINAPARTS_FX_RATE_DIRECTION=per_base

# Object storage in Saudi Arabia. s3 | local (local needs no MinIO).
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_PRIVATE_BUCKET=reels-private
S3_PUBLIC_BUCKET=reels-public
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/reels-public

# stub | sightengine
MODERATION_PROVIDER=stub
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# Empty means push is disabled for that app (logged), never a boot failure.
FCM_CUSTOMER_CREDENTIALS_JSON=
FCM_SELLER_CREDENTIALS_JSON=
# The operator surface key. Empty means every operator request is refused.
ADMIN_API_KEY=local-admin-key

# Limits (FR-070, research R24)
REEL_MAX_VIDEO_BYTES=104857600
REEL_MAX_DURATION_SECONDS=60
REEL_MAX_DESCRIPTION_LENGTH=2200
REEL_COMMENT_MAX_LENGTH=500
REEL_REPORT_REASON_MAX_LENGTH=500
FEED_PAGE_SIZE_DEFAULT=10
FEED_PAGE_SIZE_MAX=25
COMMENTS_PAGE_SIZE_DEFAULT=20
COMMENTS_PAGE_SIZE_MAX=50
REEL_MAX_PRODUCTS=5
REEL_REPORT_DAILY_LIMIT=20
REEL_REPORT_AUTOHIDE_THRESHOLD=25

# Rate limits (research R10)
IP_RATE_LIMIT_PER_MINUTE=1200
USER_RATE_LIMIT_PER_MINUTE=300
GUEST_RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_HOUR=20
WRITE_RATE_LIMIT_PER_MINUTE=30

# Sync and caches (research R4, R7, R11)
# At most 300 (FR-005).
AUTH_CACHE_TTL_SECONDS=60
# At most 10 (FR-009, FR-014).
ACCOUNT_SYNC_INTERVAL_MINUTES=5
# Mass-miss breaker: a sync that finds more than this share of accounts missing deletes nothing.
SYNC_MAX_MISSING_RATIO=0.01
PRODUCT_CARD_CACHE_SECONDS=60
FX_CACHE_SECONDS=300

# Reel links (research R15)
LINKS_PUBLIC_BASE_URL=http://localhost:3000
LINKS_PAGE_TITLE=China Parts Reels
IOS_TEAM_ID=
IOS_BUNDLE_ID=
ANDROID_PACKAGE_NAME=
ANDROID_CERT_FINGERPRINTS=
IOS_STORE_URL=https://apps.apple.com/app/id0000000000
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=placeholder

# Development-only demo content. Refused at boot when NODE_ENV=production (FR-071).
SEED_DEMO_CONTENT=false
SEED_SELLER_EXTERNAL_IDS=1
SEED_CUSTOMER_EXTERNAL_IDS=1,2
